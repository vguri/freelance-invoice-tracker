@startuml sequence-state-transition
title Send Invoice / Mark as Paid

actor Freelancer
boundary "invoices.html" as page
participant ": InvoiceController" as ic
participant ": LocalStorageHandler" as store
participant "invoice : Invoice" as inv

Freelancer -> page : click "Send" or "Mark paid"
page -> ic : changeStatus(invoiceId, newStatus)
activate ic
ic -> store : load()
activate store
store --> ic : data
deactivate store
ic -> ic : find invoice by id

ic -> inv : changeStatus(newStatus)
activate inv
alt status == "DRAFT" and newStatus == "SENT"
  inv -> inv : status = "SENT"
  inv --> ic
else (status == "SENT" or status == "OVERDUE") and newStatus == "PAID"
  inv -> inv : status = "PAID"
  inv --> ic
else any other move (e.g. "PAID" to "SENT")
  inv --> ic : throw Error("illegal status change")
end
deactivate inv

alt error thrown
  ic --> page : error message
  page --> Freelancer : show error, status unchanged
else status changed
  ic -> store : save(data)
  ic --> page : invoice
  page --> Freelancer : show new status
end
deactivate ic

note over inv
  Every allowed move lives in this one if/else chain
  inside Invoice. Adding a new status means editing it.
end note

@enduml
