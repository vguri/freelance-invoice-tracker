@startuml sequence-create-invoice
title Create Invoice and Compute Total

actor Freelancer
boundary "invoices.html" as page
participant ": InvoiceController" as ic
participant ": LocalStorageHandler" as store

Freelancer -> page : pick project, dates, billing type\nand rates, then submit
page -> ic : createInvoice(form)
activate ic
ic -> store : load()
activate store
store --> ic : data
deactivate store
ic -> ic : find project by projectId

alt project not found
  ic --> page : throw Error("project not found")
  page --> Freelancer : show error
else project found
  create participant "invoice : Invoice" as inv
  ic -> inv : new Invoice(id, project, issueDate, dueDate,\nbillingType, rates)
  note right of inv : status starts as "DRAFT"

  ic -> inv : calculateTotal()
  activate inv
  alt billingType == "HOURLY"
    inv -> inv : total = hourlyRate * hoursLogged
  else billingType == "FIXED"
    inv -> inv : total = fixedAmount
  else billingType == "RETAINER"
    inv -> inv : total = monthlyRate * months
  end
  opt hasLateFee
    inv -> inv : total += lateFeeAmount
  end
  opt hasDiscount
    inv -> inv : total -= total * discountPercent / 100
  end
  inv --> ic : total
  deactivate inv

  ic -> inv : toDisplayString()
  activate inv
  inv --> ic : text
  deactivate inv

  ic -> store : save(data)
  ic --> page : invoice, total, text
  page --> Freelancer : new invoice shown as Draft with its total
end
deactivate ic

@enduml
